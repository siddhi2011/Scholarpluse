{
  "name": "SavedScholarship",
  "type": "object",
  "properties": {
    "scholarship_id": {
      "type": "string",
      "description": "Reference to Scholarship entity"
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "in_progress",
        "applied",
        "accepted",
        "rejected"
      ],
      "default": "saved",
      "description": "Application status"
    },
    "notes": {
      "type": "string",
      "description": "User notes about this scholarship"
    },
    "applied_date": {
      "type": "string",
      "format": "date",
      "description": "Date when user applied"
    }
  },
  "required": [
    "scholarship_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}