{
  "name": "EssayDraft",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Essay title or prompt"
    },
    "content": {
      "type": "string",
      "description": "User's essay draft content"
    },
    "ai_feedback": {
      "type": "string",
      "description": "Latest AI feedback on the draft"
    },
    "scholarship_id": {
      "type": "string",
      "description": "Related scholarship if any"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}